# Build outputs (classic csproj: bin/ + obj/ hold compiled DLLs and NuGet restore assets)
bin/
obj/

# Excel-DNA generated artifacts (*.dna lists packed assemblies; *.xll are the built add-ins)
*.dna
*.xll

# Test runner output
TestResult.xml

# Visual Studio local state
.vs/
*.user
*.suo
*.dtbcache.json

# NuGet
packages/
*.nupkg

# The repo-root .gitignore has a global "build/" rule (for the Python/Electron build dir),
# which also swallows this add-in's build/ folder. Re-include it: the build & smoke scripts
# here are source, not artifacts.
!build/
!build/**
