# ---------------------------------------------------------------------------
# Core Django
# ---------------------------------------------------------------------------
# Generate a real value with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# When DJANGO_DEBUG=False the app will refuse to start with the default
# `django-insecure-...` value, so a real one is mandatory in production.
SECRET_KEY=your-secret-key-here

# Set to False in production. When False, missing SECRET_KEY above (or
# the default `django-insecure-` value) will raise ImproperlyConfigured.
DJANGO_DEBUG=True

# Comma-separated hostnames the app will serve. Use the real domain(s) in
# production; the dev default `*` is fine locally.
DJANGO_ALLOWED_HOSTS=*

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
DATABASE_URL=postgres://ate_user:ate_password@localhost:5432/ate_analysis

# ---------------------------------------------------------------------------
# Redis (Celery broker + SFTP session cache)
# ---------------------------------------------------------------------------
# One Redis URL for everything by default. The SFTP session cache resolves
# SFTP_SESSION_REDIS_URL → REDIS_URL → CELERY_BROKER_URL in that order.
REDIS_URL=redis://localhost:6379/0

# ---------------------------------------------------------------------------
# SFTP password encryption
# ---------------------------------------------------------------------------
# Dedicated Fernet key for encrypting saved SftpConfig passwords AND the
# transient SFTP session cache. Rotate independently of SECRET_KEY.
# Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Leaving this unset in production triggers a startup warning; the key will
# fall back to a PBKDF2 derivation from SECRET_KEY.
SFTP_CONFIG_KEY=

# TTL (seconds) for the shared-Redis SFTP session cache. The default 3600
# matches the previous Django cache TTL.
SFTP_SESSION_TTL=3600

# Optional: override the Redis URL used ONLY for the SFTP session cache.
# When unset the cache falls back to REDIS_URL / CELERY_BROKER_URL.
# SFTP_SESSION_REDIS_URL=redis://localhost:6379/1
