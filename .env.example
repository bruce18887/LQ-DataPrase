# ---------------------------------------------------------------------------
# Core Django
# ---------------------------------------------------------------------------
# Generate a real value with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# When DJANGO_DEBUG=False the app will refuse to start with the default
# `django-insecure-...` value, so a real one is mandatory in production.
SECRET_KEY=your-secret-key-here

# Set to False in production. When False, missing SECRET_KEY above (or
# the default `django-insecure-` value) will raise ImproperlyConfigured.
DJANGO_DEBUG=True

# Comma-separated hostnames the app will serve. Use the real domain(s) in
# production; the dev default `*` is fine locally.
DJANGO_ALLOWED_HOSTS=*

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# None. The project uses SQLite in every profile (development, standalone,
# server, e2e_slot); the database path is derived from BASE_DIR / the storage
# config, not from an env var. A DATABASE_URL was listed here historically but
# nothing ever read it — PostgreSQL support was dead code and was removed on
# 2026-10-15 (architecture review P0-1b).

# ---------------------------------------------------------------------------
# Redis (optional — SFTP session cache only)
# ---------------------------------------------------------------------------
# The ONLY consumer is the SFTP session cache. It resolves
# SFTP_SESSION_REDIS_URL → REDIS_URL, probes it lazily, and silently falls back
# to Django's in-process LocMemCache when unreachable. Both shipped profiles
# blank these two settings on purpose, so a Redis server is never required.
# Leave as-is for a single-process dev setup; set a real URL only if you need
# SFTP sessions shared across workers/hosts.
REDIS_URL=redis://localhost:6379/0

# ---------------------------------------------------------------------------
# SFTP password encryption
# ---------------------------------------------------------------------------
# Dedicated Fernet key for encrypting saved SftpConfig passwords AND the
# transient SFTP session cache. Rotate independently of SECRET_KEY.
# Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Leaving this unset in production triggers a startup warning; the key will
# fall back to a PBKDF2 derivation from SECRET_KEY.
SFTP_CONFIG_KEY=

# TTL (seconds) for the shared-Redis SFTP session cache. The default 3600
# matches the previous Django cache TTL.
SFTP_SESSION_TTL=3600

# Optional: override the Redis URL used ONLY for the SFTP session cache.
# When unset the cache falls back to REDIS_URL.
# SFTP_SESSION_REDIS_URL=redis://localhost:6379/1

# ---------------------------------------------------------------------------
# Login rate limit (IP-scoped)
# ---------------------------------------------------------------------------
# Complements the per-account lockout in apps/accounts/views.py (5 failures →
# 423 + 15 min lock) with an IP dimension, so one host cannot enumerate
# usernames or lock out legitimate accounts by spraying failures. The dev and
# e2e profiles raise this to 200/min so test suites never trip it.
# LQDP_LOGIN_THROTTLE_RATE=20/min

# ---------------------------------------------------------------------------
# Graceful shutdown (packaged/Electron builds only)
# ---------------------------------------------------------------------------
# Electron generates a random token per launch and passes it here; the backend
# then mounts POST /api/v1/system/shutdown/ and requires that token plus a
# loopback source. Without this var the endpoint is not mounted at all.
# LQDP_SHUTDOWN_TOKEN=
