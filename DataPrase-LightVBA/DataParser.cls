Private Sub TestDataRowCalibration(ReCali As Boolean)
    If g_DataWS.Cells(1, 1) = Tester(0).DatalogIdentifier Then
        g_TesterType = 0
    ElseIf g_DataWS.Cells(1, 1) = Tester(1).DatalogIdentifier Then
        g_TesterType = 1
    ElseIf g_DataWS.Cells(1, 1) = Tester(2).DatalogIdentifier Then
        g_TesterType = 2
    ElseIf InStr(1, g_DataWS.Cells(1, 1), Tester(3).DatalogIdentifier, vbTextCompare) > 0 Then
        g_TesterType = 3
    ElseIf InStr(1, g_DataWS.Cells(1, 1), Tester(4).DatalogIdentifier, vbTextCompare) > 0 Then
        g_TesterType = 4
    Else
        'Some time ETS88 data firt row is not 'Report Generated By'
        If g_DataWS.Cells(2, 1) = Tester(0).DatalogIdentifier Or g_DataWS.Cells(3, 1) = Tester(0).DatalogIdentifier Then
             g_TesterType = 0
        Else
            MsgBox "Unsupported Datalog Type!" & vbCrLf & _
                    "ETS88: first cell should be 'Report Generated By'" & vbCrLf & _
                    "CTA8290D: first cell should be '[GENERAL]'" & vbCrLf & _
                    "CTA8280F: first cell should be 'CTA8280F'"
            Exit Sub
        End If
    End If
    
    
    ' Iterate first column until empty cell
    Index = 0
    For Each cell In g_DataWS.Range("A:A")
        Index = Index + 1
        If cell.Value = Tester(g_TesterType).TestNameRowIdentifier Then
            TestNameIndex = Index
'            If g_TesterType <> 0 Then
'                TestNameIndex = TestNameIndex + 1
'
'            End If
            TestDataColIndex(0) = Tester(g_TesterType).TestItemStartIndex
            currentCol = TestDataColIndex(0)
            ' Iterate first row until empty cell
            Do While Not IsEmpty(g_DataWS.Cells(TestNameIndex, currentCol))
                currentCol = currentCol + 1
            Loop
           TestDataColIndex(1) = currentCol - 1
           
           
            'Get DataRow Stat Index
            If ReCali = False Then
                TestDataRowIndex(0) = Index + Tester(g_TesterType).DataRowOffset
            Else
                TestDataRowIndex(0) = Index + Tester(g_TesterType).DataRowOffset + 7
                If g_TesterType = 0 Then: TestDataRowIndex(0) = TestDataRowIndex(0) - 1
            End If
  
        End If
        

        'Get DataRow Stop Index
        If (TestDataRowIndex(0) <> 0) And (Index > TestDataRowIndex(0)) Then
            'old use double emptycell to determine stop index
            'If IsEmpty(g_DataWS.Cells(Index, 1)) And IsEmpty(g_DataWS.Cells(Index - 1, 1)) Then
            '    If g_TesterType = 0 Then
            '        TestDataRowIndex(1) = Index - 5
            '    Else
            '        TestDataRowIndex(1) = Index - 2
            '    End If
            '   Exit For
            'End If
            
            '2025-05-09 liqun new update:due to ETS88 data format change to read string
            If g_TesterType <> 0 Then
                If IsEmpty(g_DataWS.Cells(Index, 1)) And IsEmpty(g_DataWS.Cells(Index - 1, 1)) Then
                    TestDataRowIndex(1) = Index - 2
                    Exit For
                End If
            Else
                If cell.Value = "Data Collection Start Date" Then
                    TestDataRowIndex(1) = Index - 2
                    Exit For
                End If
            End If
            
        End If
    Next cell
End Sub

Private Sub TestItemInfoGet()
    ' Get TestItemInfo
    ReDim Items(TestDataColIndex(1))
    
    Dim lowOffset As Integer
    Dim highOffset As Integer
    Dim unitOffset As Integer
    
    lowOffset = Tester(g_TesterType).lowOffset
    highOffset = Tester(g_TesterType).highOffset
    unitOffset = Tester(g_TesterType).unitOffset
    
    For i = TestDataColIndex(0) To TestDataColIndex(1)
        With g_DataWS
            Items(i).TestName = .Cells(TestNameIndex, i).Value
            
            If .Cells(TestNameIndex + lowOffset, i).Value <> " " Then
                Items(i).Lolimit = .Cells(TestNameIndex + lowOffset, i).Value
            End If
            
            If .Cells(TestNameIndex + highOffset, i).Value <> " " Then
                Items(i).Hilimit = .Cells(TestNameIndex + highOffset, i).Value
            End If
            
            Items(i).Unit = .Cells(TestNameIndex + unitOffset, i).Value
        End With
        
        Items(i).NoLimit = (Items(i).Lolimit = Empty And Items(i).Hilimit = Empty)
    Next
End Sub

Private Sub TestDataMark()
    ' Read the entire range into an array
    Dim BinDataArray() As Variant
    BinDataArray = g_DataWS.Range(Tester(g_TesterType).BinColumn & 1 & ":" & Tester(g_TesterType).BinColumn & TestDataRowIndex(1)).Value
    'find and mark fail data by bin cell
    For i = TestDataRowIndex(0) To TestDataRowIndex(1) Step 1
        BinValue = BinDataArray(i, 1)
        If BinValue <> "" And BinValue <> 1 Then
            g_DataWS.Range(Tester(g_TesterType).BinColumn & i).Interior.ColorIndex = 3
            Dim dataArray() As Variant
            dataArray = g_DataWS.Range(g_DataWS.Cells(i, 1), g_DataWS.Cells(i, TestDataColIndex(1))).Value
            For j = TestDataColIndex(0) To TestDataColIndex(1) Step 1
                CellValue = dataArray(1, j)
                If Items(j).NoLimit <> True And CellValue <> "" Then
                    If (CellValue = Items(j).Hilimit And CellValue <> Items(j).Lolimit) Or (CellValue <> Items(j).Hilimit And CellValue = Items(j).Lolimit) Then
                        g_DataWS.Cells(i, j).Interior.ColorIndex = 44
                    ElseIf CellValue > Items(j).Hilimit Or CellValue < Items(j).Lolimit Then
                        With g_DataWS.Cells(i, j)
                            .Interior.ColorIndex = 3
                            .Font.Bold = True
                        End With
                    End If
                End If
            Next j
        End If
    Next i
End Sub

Private Sub DataDistribtuionFormula_Refresh(ColumnLetter)

    Application.ScreenUpdating = False
    'Application.Calculation = xlCalculationManual
    Set ExpWS = ActiveWorkbook.Sheets("Exp")
    If TestDataRowIndex(1) = 0 Then
        MsgBox "Warning! The number of test items equals to zero! Please re-import it with TestItemImport button!  "
        Exit Sub
    End If
    
    OperateColLetter = ColumnLetter
    
    LSLCell = OperateColLetter & (TestNameIndex + Tester(g_TesterType).lowOffset)
    HSLCell = OperateColLetter & (TestNameIndex + Tester(g_TesterType).highOffset)
    MinCell = OperateColLetter & (TestNameIndex + Tester(g_TesterType).MinOffset)
    MaxCell = OperateColLetter & (TestNameIndex + Tester(g_TesterType).MaxOffset)
    UnitCell = OperateColLetter & (TestNameIndex + Tester(g_TesterType).unitOffset)
    RangeCell = OperateColLetter & (TestNameIndex + Tester(g_TesterType).RangeOffset)
    MeanCell = OperateColLetter & (TestNameIndex + Tester(g_TesterType).MeanOffset)
    STDCell = OperateColLetter & (TestNameIndex + Tester(g_TesterType).STDOffset)
    CPKCell = OperateColLetter & (TestNameIndex + Tester(g_TesterType).CPKOffset)


    SiteStartCell = Tester(g_TesterType).SiteColumn & "$" & TestDataRowIndex(0)
    SiteStopCell = Tester(g_TesterType).SiteColumn & "$" & TestDataRowIndex(1)
    SiteColumnRange = "Data!" & SiteStartCell & ":Data!" & SiteStopCell
      
    DataStartCell = OperateColLetter & "$" & TestDataRowIndex(0)
    DataStopCell = OperateColLetter & "$" & TestDataRowIndex(1)
    DataRange = "Data!" & DataStartCell & ":Data!" & DataStopCell
    
    formula_Counter_All = "=COUNTIFS(" & DataRange & ","">"" & Exp!$D3," & DataRange & ",""<=""& Exp!$D4)"

    ExpWS.Range("Exp!E3").Formula = "=COUNTIFS(" & DataRange & ",""<="" & Exp!$D3)"
    ExpWS.Range("Exp!E27").Formula = "=COUNTIFS(" & DataRange & ","">="" & Exp!$D27)"
    With ExpWS.Range(ExpWS.Cells(4, 5), ExpWS.Cells(26, 5))
        .Formula = formula_Counter_All
    End With
    
    
    'Unit/Range/STD/Mean/CPK
    ExpWS.Range("G36").Formula = "=Data!" & UnitCell

    ExpWS.Range("C53").Formula = "=Data!" & RangeCell
    ExpWS.Range("C54").Formula = "=Data!" & MeanCell
    ExpWS.Range("C55").Formula = "=Data!" & STDCell
    ExpWS.Range("C56").Formula = "=Data!" & CPKCell


    'Limit
    ExpWS.Range("D36").Formula = "=Data!" & LSLCell
    ExpWS.Range("E36").Formula = "=Data!" & HSLCell
    
    ExpWS.Range("D37").Formula = "=Data!" & MinCell
    ExpWS.Range("E37").Formula = "=Data!" & MaxCell

'    ExpWS.Range("D38").Formula = "=Exp!D36"
'    ExpWS.Range("E38").Formula = "=Exp!E36"
    
    ExpWS.Range("D39").Formula = "=Data!" & MeanCell & "-3*Data!" & STDCell
    ExpWS.Range("E39").Formula = "=Data!" & MeanCell & "+3*Data!" & STDCell

    ExpWS.Range("D40").Formula = "=Data!" & MeanCell & "-6*Data!" & STDCell
    ExpWS.Range("E40").Formula = "=Data!" & MeanCell & "+6*Data!" & STDCell

    'OptionButtion select limit
    With ExpWS.Range(ExpWS.Cells(3, 4), ExpWS.Cells(27, 4))
        .Formula = "=$D$" & (36 + ExpWS.Range("$B36").Value) & "+B3*$F$" & (36 + ExpWS.Range("$B36").Value)
    End With

    
    'SITE1~8
    For i = 1 To 8 Step 1
        ExpWS.Cells(3, 5 + i).Formula = "=COUNTIFS(" & DataRange & ",""<="" & Exp!$D3," & SiteColumnRange & "," & """= " & i & """)"
        ExpWS.Cells(27, 5 + i).Formula = "=COUNTIFS(" & DataRange & ","">="" & Exp!$D27," & SiteColumnRange & "," & """= " & i & """)"
        formula_Counter_Site = "=COUNTIFS(" & DataRange & ","">"" & Exp!$D3," & DataRange & ",""<=""& Exp!$D4," & SiteColumnRange & "," & """= " & i & """)"
        With ExpWS.Range(ExpWS.Cells(4, 5 + i), ExpWS.Cells(26, 5 + i))
            .Formula = formula_Counter_Site
        End With
    Next
    

    Application.ScreenUpdating = True '
    'Application.Calculation = xlCalculationAutomatic

End Sub

Public Sub ComboBox_Changed()
    'TestItem Name
    ActiveWorkbook.Sheets("Exp").Range("Exp!B43").Value = ActiveWorkbook.Sheets("Exp").ComboBox1.Text
    
    'TestItem Index
    Dim ColLetter As String
    Dim remainder As Long
    Dim colNumber As Integer
    colNumber = g_ComboBox.ListIndex + TestDataColIndex(0)
    Do While colNumber > 0
        remainder = (colNumber - 1) Mod 26
        ColLetter = Chr(65 + remainder) & ColLetter
        colNumber = Int((colNumber - 1) / 26)
    Loop

    DataDistribtuionFormula_Refresh (ColLetter)
End Sub

Public Sub ImportButton_Changed()

    Set g_DataWS = ActiveWorkbook.Sheets("Data")
    Set g_ComboBox = ActiveWorkbook.Sheets("Exp").ComboBox1
    
    Initialize
    
    'Calibrate TestDataRow
    TestDataRowCalibration True

    'Get TestItemInfo
    TestItemInfoGet

    'Update to ComboBox1
    g_ComboBox.Clear
    For Each cell In g_DataWS.Range(g_DataWS.Cells(TestNameIndex, TestDataColIndex(0)), g_DataWS.Cells(TestNameIndex, TestDataColIndex(1)))
        g_ComboBox.AddItem cell.Value
    Next cell

End Sub

Public Sub ProcessDataAndMarkFailuresConfigRun(config As ConfigInfo)
    Application.ScreenUpdating = False
    Application.Calculation = xlCalculationManual
    

    Initialize
    
    If ActiveWorkbook.ActiveSheet.Name <> "Data" Then
        ActiveWorkbook.ActiveSheet.Name = "Data"
    End If
    
    Set g_DataWS = ActiveWorkbook.Sheets("Data")
    
    'This is first calibrate
    TestDataRowCalibration False
    
    'Delete ETS88's empty row between SITE to SITE
    EmptyRowDeleteCount = 0
    If g_TesterType = 0 Then
        For currentRow = TestDataRowIndex(1) To TestDataRowIndex(0) Step -1
            If g_DataWS.Cells(currentRow, 1).Value = "" Then
                g_DataWS.Rows(currentRow).Delete
                EmptyRowDeleteCount = EmptyRowDeleteCount + 1
            End If
        Next
    End If

    'Insert row
    TotalInsertRows = 0
    If g_TesterType = 0 Then
        TotalInsertRows = 6
    ElseIf g_TesterType = 3 Then
        TotalInsertRows = 6
    Else
        TotalInsertRows = 7
    End If
    
    For i = 1 To TotalInsertRows
        g_DataWS.Rows(TestNameIndex + Tester(g_TesterType).FormulaRowOffset).Insert Shift:=xlDown, CopyOrigin:=xlFormatFromLeftOrAbove
    Next i

    'reget DataRow index
    TestDataRowIndex(0) = TestDataRowIndex(0) + TotalInsertRows
    TestDataRowIndex(1) = TestDataRowIndex(1) + TotalInsertRows - EmptyRowDeleteCount
    
    
    
    'DataSheet formula
    DataSheetFormulaRow = TestNameIndex + Tester(g_TesterType).FormulaRowOffset - 1
    g_DataWS.Cells(DataSheetFormulaRow + 1, 1).Value = "Min"
    g_DataWS.Cells(DataSheetFormulaRow + 2, 1).Value = "Avg"
    g_DataWS.Cells(DataSheetFormulaRow + 3, 1).Value = "Max"
    g_DataWS.Cells(DataSheetFormulaRow + 4, 1).Value = "Range"
    g_DataWS.Cells(DataSheetFormulaRow + 5, 1).Value = "STD"
    g_DataWS.Cells(DataSheetFormulaRow + 6, 1).Value = "CPK"

    TestDataColIndexLetter = ColumnNumberToLetter(TestDataColIndex(0))
    'MinCell = TestDataColIndexLetter & (DataSheetFormulaRow + 1)
    'MeanCell = TestDataColIndexLetter & (DataSheetFormulaRow + 2)
    'MaxCell = TestDataColIndexLetter & (DataSheetFormulaRow + 3)
    'STDCell = TestDataColIndexLetter & (DataSheetFormulaRow + 5)
    'LSLCell = TestDataColIndexLetter & (DataSheetFormulaRow - 2 + Tester(g_TesterType).LimitRowOffset)
   ' HSLCell = TestDataColIndexLetter & (DataSheetFormulaRow - 1 + Tester(g_TesterType).LimitRowOffset)


    LSLCell = TestDataColIndexLetter & (TestNameIndex + Tester(g_TesterType).lowOffset)
    HSLCell = TestDataColIndexLetter & (TestNameIndex + Tester(g_TesterType).highOffset)
    MinCell = TestDataColIndexLetter & (TestNameIndex + Tester(g_TesterType).MinOffset)
    MaxCell = TestDataColIndexLetter & (TestNameIndex + Tester(g_TesterType).MaxOffset)
    UnitCell = TestDataColIndexLetter & (TestNameIndex + Tester(g_TesterType).unitOffset)
    RangeCell = TestDataColIndexLetter & (TestNameIndex + Tester(g_TesterType).RangeOffset)
    MeanCell = TestDataColIndexLetter & (TestNameIndex + Tester(g_TesterType).MeanOffset)
    STDCell = TestDataColIndexLetter & (TestNameIndex + Tester(g_TesterType).STDOffset)
    CPKCell = TestDataColIndexLetter & (TestNameIndex + Tester(g_TesterType).CPKOffset)




    DataStartCell = TestDataColIndexLetter & TestDataRowIndex(0)
    DataStopCell = TestDataColIndexLetter & TestDataRowIndex(1)
    
    formula_Min = "=SUBTOTAL(105," + DataStartCell + ":" + DataStopCell + ")"
    '¦Ì:
    formula_Avg = "=SUBTOTAL(101," + DataStartCell + ":" + DataStopCell + ")"
    formula_Max = "=SUBTOTAL(104," + DataStartCell + ":" + DataStopCell + ")"
    formula_Range = "=" + MaxCell + "-" + MinCell

    formula_STD = "=SUBTOTAL(108," + DataStartCell + ":" + DataStopCell + ")"


    'ratio_low = (Mean - LSL)/3¦²
    'ratio_high = (HSL - Mean)/3¦²
    'CPK = Min of (ratio_low,ratio_high)
    formula_CPK = "=IF(OR(" + STDCell + "=0,AND(" + LSLCell + "=""""," + HSLCell + "="""")),"""",MIN((" + MeanCell + "-" + LSLCell + ")/3/" + STDCell + ",(" + HSLCell + "-" + MeanCell + ")/3/" + STDCell + "))"


    With Range(Cells(DataSheetFormulaRow + 1, TestDataColIndex(0)), Cells(DataSheetFormulaRow + 1, TestDataColIndex(1)))
        .Formula = formula_Min
    End With

    With Range(Cells(DataSheetFormulaRow + 2, TestDataColIndex(0)), Cells(DataSheetFormulaRow + 2, TestDataColIndex(1)))
        .Formula = formula_Avg
    End With

    With Range(Cells(DataSheetFormulaRow + 3, TestDataColIndex(0)), Cells(DataSheetFormulaRow + 3, TestDataColIndex(1)))
        .Formula = formula_Max
    End With

    With Range(Cells(DataSheetFormulaRow + 4, TestDataColIndex(0)), Cells(DataSheetFormulaRow + 4, TestDataColIndex(1)))
        .Formula = formula_Range
    End With

    With Range(Cells(DataSheetFormulaRow + 5, TestDataColIndex(0)), Cells(DataSheetFormulaRow + 5, TestDataColIndex(1)))
        .Formula = formula_STD
    End With

    With Range(Cells(DataSheetFormulaRow + 6, TestDataColIndex(0)), Cells(DataSheetFormulaRow + 6, TestDataColIndex(1)))
        .Formula = formula_CPK
    End With
    
    
    If config.EnableAutoForzen = True Then
        ' frozen cell
        ActiveWindow.ScrollRow = TestNameIndex
        g_DataWS.Cells(TestDataRowIndex(0), TestDataColIndex(0)).Select
        ActiveWindow.FreezePanes = True
    End If
    
    If config.EnableAutoHideColumns Then
        'Hide some column
        If g_TesterType = 1 Then
            g_DataWS.Columns("B").Hidden = True 'Part_No
            g_DataWS.Columns("E").Hidden = True 'Dut_Pass
            g_DataWS.Columns("G:J").Hidden = True 'X_COORD Y_COORD QR_Code Start_T
            g_DataWS.Columns("L:M").Hidden = True 'Alarm Data_Cnt
        'ElseIf g_TesterType = 2 Then
        '    g_DataWS.Columns("E:G").Hidden = True 'X_COORD Y_COORD QR_Code
        '    g_DataWS.Columns("I").Hidden = True 'Data_Num
        End If
    End If

    
    'Filter
    If config.EnableAutoFilter Then
            g_DataWS.Rows((TestDataRowIndex(0) - 1) & ":" & (TestDataRowIndex(0) - 1)).Select
            Selection.AutoFilter
    End If

    
    'Get TestItemInfo
    TestItemInfoGet

    'Mark TestData
    TestDataMark
    
   
   If config.EnableAutoCopyMarkedFile Then
        Dim DataWB As Workbook
        Set DataWB = ActiveWorkbook
        
        Dim newFilePath As String
        Dim originalFileNameWithoutExt As String
        
        Dim originalFilePath As String
        originalFilePath = DataWB.FullName
        
        
        Dim folderPath As String
        folderPath = Left$(originalFilePath, InStrRev(originalFilePath, "\"))
        
        
        Dim originalFileName As String
        originalFileName = DataWB.Name
        
        
        Dim extPos As Long
        extPos = InStrRev(originalFileName, ".")
        
        If extPos > 0 Then
            originalFileNameWithoutExt = Left$(originalFileName, extPos - 1)
        Else
            originalFileNameWithoutExt = originalFileName
        End If
        
        newFilePath = folderPath & originalFileNameWithoutExt & "Copy.xlsx"
        
        DataWB.SaveAs FileName:=newFilePath, FileFormat:=xlOpenXMLWorkbook
        
        MsgBox "The file was saved as : " & newFilePath
   End If

   

   
    If config.EnableAutoDataDistribution Then
        'copy exp sheet to Data Excel
        ThisWorkbook.Sheets("Exp").Copy After:=ActiveWorkbook.Sheets(ActiveWorkbook.Sheets.count)
        
        'Debug.Print ActiveWorkbook.Name
        
        'Update to ComboBox1
        Set g_ComboBox = ActiveWorkbook.Sheets("Exp").ComboBox1
        g_ComboBox.Clear
        
        BinDataArray = g_DataWS.Range(g_DataWS.Cells(TestNameIndex, TestDataColIndex(0)), g_DataWS.Cells(TestNameIndex, TestDataColIndex(1)))
        
        For i = 1 To (TestDataColIndex(1) - TestDataColIndex(0) + 1) Step 1
            g_ComboBox.AddItem BinDataArray(1, i)
        Next i

    End If
    
  
    ' frozen Exp cell
    'ActiveWindow.ScrollRow = 30 'first row to Testname
    'Cells(30, 2).Select
    'ActiveWindow.FreezePanes = True
    
    
    Application.ScreenUpdating = True
    Application.Calculation = xlCalculationAutomatic
End Sub
