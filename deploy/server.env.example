# LQ-DataPrase 服务器形态环境文件模板（config.settings.server · 方案 A）
# 安装与权限见 deploy/README.md。
# 每行只写 KEY=值；值后面不要加 # 注释（systemd 会把它算进值里）。

DJANGO_SETTINGS_MODULE=config.settings.server
LQDP_SERVER_BASE_DIR=/srv/lqdp
DJANGO_ALLOWED_HOSTS=10.0.0.9,server01
SECRET_KEY=CHANGE_ME
SFTP_CONFIG_KEY=CHANGE_ME
LQDP_BOOTSTRAP_ADMIN_PASSWORD="CHANGE_ME"
MPLCONFIGDIR=/srv/lqdp/.mpl

# 可选：隐藏 runserver 的 “development server” 横幅（只影响这一条提示）
# DJANGO_RUNSERVER_HIDE_WARNING=true
